APP_NAME="Cybersecurity Learning and Operations Simulation Platform"
APP_ENV=local
APP_PROFILE=local
APP_KEY=<GENERATE_LOCALLY>
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cyber_platform
DB_USERNAME=cyber_platform
DB_PASSWORD=<SET_LOCAL_RANDOM_PASSWORD>
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_TABLE=application_sessions
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local
BLOB_DISK=local
BLOB_ROOT=blobs

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
